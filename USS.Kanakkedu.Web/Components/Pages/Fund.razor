@using USS.Kanakkedu.ClientService

@page "/fund"

@rendermode InteractiveServer

@inject KanakkeduHTTPClient http;

@if (funds?.Count>0)
{

    <table class="table table-striped table-hover table-bordered">
        <thead class="table-primary">
            <tr>
                <th scope="col">Id</th>
                <th scope="col">Name</th>
                <th scope="col">IsActive</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fund in funds)
            {
                <tr>
                    <td>@fund.data.Id</td>
                    <td>
                        @if (fund.IsEdit)
                        {
                            <input @bind="fund.EditData.Name" type="text" class="form-control" placeholder="Enter your name" aria-label="Name" />
                        }
                        else
                        {
                            @fund.data.Name
                        }
                    </td>
                    <td>@fund.data.IsActive</td>
                    <td>
                        @if (fund.IsEdit)
                        {
                            <button class="btn btn-primary" @onclick=@( x=> Save(fund) ) >Save</button>
                            <button class="btn btn-danger" @onclick=@( x=> Cancel(fund))>Cancel</button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick=@( x=> Edit(fund) )>Edit</button>
                            <button class="btn btn-danger" @onclick=@( x=> Delete(fund))>Delete</button>
                        }

                    </td>
                </tr>
            }
        </tbody>
        <tfoot>
            @if(funds.Count(x=> x.data.Id == 0) == 0)
            {
                <tr>
                    <td colspan="4"><button class="btn btn-primary" @onclick="Add">Add Fund</button></td>
                </tr>
            }
            
        </tfoot>
    </table>
}
       



@code {

    class FundModel 
    {
        public Model.Fund data { get; set; }
        public Model.Fund EditData { get; set; }
        public bool IsEdit { get; set; }
    }

    private List<FundModel> funds { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        var result = await http.FundAllAsync();
        funds = result.Select(x => new FundModel() { data = x, IsEdit = false }).ToList();
    } 


    void Add()
    {
        FundModel fund = new(){data = new(),EditData=new(),IsEdit=true};
        funds.Add(fund);
    }
    void Edit(FundModel f)
    {
        f.IsEdit = true;
        f.EditData = new() { Name = f.data.Name, IsActive = f.data.IsActive };
    }
    void Delete(FundModel f)
    {
        funds.Remove(f);
    }
    async void Save(FundModel f)
    {
        f.IsEdit = false;
        f.data.Name = f.EditData.Name;
        f.data.IsActive = f.EditData.IsActive;
        if (f.data.Id == 0)
        {
          var result = await http.InsertFundAsync(f.data);
        }
    }
    void Cancel(FundModel f)
    {

        if (f.data.Id == 0) funds.Remove(f);
        else f.IsEdit = false;
    }
}
