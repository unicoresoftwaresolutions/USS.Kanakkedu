@page "/fund"
@using USS.Kanakkedu.ClientService

@inject KanakkeduHTTPClient http;
@if (funds?.Count>0)
{

    <table>
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>IsActive</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var fund in funds)
            {
                <tr>
                    <td>@fund.Id</td>
                    <td>@fund.Name</td>
                    <td>@fund.IsActive</td>
                    <td>
                        <button class="btn btn-primary">Edit</button>
                        <button class="btn btn-danger">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
       



@code {

    private List<Model.Fund> funds { get; set; }


    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

       funds = await http.FundAllAsync();
    } 

}
