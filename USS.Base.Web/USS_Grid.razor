@typeparam T
@using USS.Base.Extension

<table class="table table-striped table-hover table-bordered">
    
    <thead class="table-primary">
        <tr>
            @foreach (var p in type.GetProperties())
            {
                <th>@p.Name</th>
            }
            @if (IsAction)
            {
                <th>Action</th>
            }        
        </tr>
    </thead>
    @if (Values?.Count > 0)
    {
        <tbody>

            @foreach (var fund in Values)
            {

                var data = fund.GetPropertyValue("data");

                <tr>
                    @foreach (var p in type.GetProperties())
                    {
                        <td>@data?.GetPropertyValue(p.Name)</td>
                    }

                    @if (IsAction)
                    {
                        <td>
                            @if ((bool)fund.GetPropertyValue("IsEdit"))
                            {
                                <button class="btn btn-primary" @onclick=@( x => OnSave.InvokeAsync(fund))>Save</button>
                                <button class="btn btn-danger" @onclick=@( x => { OnCancel.InvokeAsync(fund);})>Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-primary" @onclick=@( x => OnEdit.InvokeAsync(fund))>Edit</button>
                                <button class="btn btn-danger" @onclick=@( x => OnDelete.InvokeAsync(fund))>Delete</button>
                            }
                        </td>



                    }
                </tr>
            }
        </tbody>
    }
    <tfoot>
        @if (IsAction && (Values?.Count(x => (Guid)x.GetPropertyValue("data").GetPropertyValue("Id") == default) ?? 0) == 0)
        {
            <tr>
                <td colspan="4"><button class="btn btn-primary" @onclick="@( x=>{ OnAdd.InvokeAsync(); })">Add Fund</button></td>
            </tr>
        }

    </tfoot>
    
</table>

